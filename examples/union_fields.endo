// Discriminated unions with named fields and dot-access

// --- Basic named field ---

type Shape =
    | Circle of radius: int
    | Point

let c = Circle 42

print "c = "
println c
print "c.radius = "
println c.radius

let p = Point

print "p = "
println p

type Rect =
    | Rect of w: int * h: int

// --- Multi-field variant ---

let r = Rect (10, 20)

print "r = "
println r
print "r.w = "
println r.w
print "r.h = "
println r.h

type Foo =
    | A of x: int
    | B of int
    | C

// --- Mixed variants (named, unnamed, and unit) ---

let a = A 10

let b = B 99

let fc = C

print "a = "
println a
print "b = "
println b
print "fc = "
println fc

// --- Dot-access in expressions ---

let area = r.w * r.h

print "area = "
println area

let doubled = Circle (c.radius * 2)

print "doubled.radius = "
println doubled.radius

// --- Pattern matching still works ---

let describe_shape s =
    match s with
    | Circle radius -> $"circle with radius {radius}"
    | Point -> "a point"

println (describe_shape c)
println (describe_shape p)

type Figure =
    | Sq of side: int
    | Tri of base: int * height: int

// --- Practical example: area computation ---

let fig_area f =
    match f with
    | Sq s -> s * s
    | Tri (b, h) -> b * h / 2

let sq = Sq 5

let tri = Tri (6, 4)

print "sq area = "
println (fig_area sq)
print "tri area = "
println (fig_area tri)

// Dot-access for readability
print "sq.side = "
println sq.side
print "tri.base = "
println tri.base
print "tri.height = "
println tri.height
