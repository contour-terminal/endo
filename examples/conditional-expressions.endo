# description: Test if/else conditional expressions
# expect: 5 is not equal to 10.
# expect: 10 is not equal to 5.
# expect: 5 equals 5.
# expect:

let test x y =
    if x == y then "equals"
    else "is not equal to"

let test2 x y =
    if x == y then
        "equals"
    elif x < y then "is less than"
    else "is greater than"

let testAndPrint x y = println $"{x} {test x y} {y}."

testAndPrint 5 10
testAndPrint 10 5
testAndPrint 5 5
