let flatpak_complete args prefix =
    let subcommands = [
        "run"; "install"; "uninstall"; "update"; "list"; "info"; "search"; "override"; "remotes";
        "remote-add"; "remote-delete"; "remote-modify"; "remote-ls"; "remote-info"; "config";
        "repair"; "history"; "ps"; "kill"; "enter"; "mask"; "pin"; "make-current"; "create-usb";
        "repo"; "documents"; "document-export"; "document-unexport"; "document-info";
        "permission-reset"; "permission-remove"; "permission-set"; "permission-show"
    ]
    let options = [
        "--user"; "--system"; "--installation"; "--verbose"; "-v"; "--help"; "-h"; "--version"
    ]
    let run_options = [
        "--branch"; "--arch"; "--command"; "--runtime"; "--user"; "--system"; "--verbose"; "-v"
    ]
    match args with
    | [] when startsWith "-" prefix -> options
    | [] -> subcommands
    | ["run"] when startsWith "-" prefix -> run_options
    | ["run"] | ["kill"] | ["override"] -> $(flatpak list --app --columns=application)
        |> split "\n"
        |> filter (fun s -> s != "")
    | ["uninstall"] | ["update"] | ["info"] -> $(flatpak list --columns=application)
        |> split "\n"
        |> filter (fun s -> s != "")
    | ["remote-delete"] | ["remote-modify"] | ["remote-ls"] | ["remote-info"] -> $(flatpak remotes --columns=name)
        |> split "\n"
        |> filter (fun s -> s != "")
    | _ -> []

register_completer "flatpak" flatpak_complete
