let ssh_hosts _ =
    $(grep -i "^Host " ~/.ssh/config)
        |> split "\n"
        |> filter (_ != "")
        |> map (fun line ->
            match split " " line with
            | _ :: host :: _ -> host
            | _ -> "")
        |> filter (_ != "")
        |> filter (fun s -> not (contains "*" s))
