let cmake_complete args prefix =
    let options = [
        Completion.described "--preset" "Use a configure preset";
        Completion.described "--list-presets" "List available presets";
        Completion.described "--build" "Build a project";
        Completion.described "--install" "Install a project";
        Completion.described "-S" "Source directory";
        Completion.described "-B" "Build directory";
        Completion.described "-G" "Generator name";
        Completion.described "-D" "Define a variable";
        Completion.described "--parallel" "Parallel build jobs";
        Completion.described "-j" "Parallel build jobs";
        Completion.described "--target" "Build target";
        Completion.described "-t" "Build target";
        Completion.described "--config" "Build configuration";
        Completion.described "--clean-first" "Clean before building";
        Completion.described "--verbose" "Enable verbose output";
        Completion.described "-v" "Enable verbose output";
        Completion.described "--version" "Show version";
        Completion.described "--help" "Show help"
    ]
    let generators = ["Ninja"; "Ninja Multi-Config"; "Unix Makefiles"; "Watcom WMake"]
    let configs = ["Debug"; "Release"; "RelWithDebInfo"; "MinSizeRel"]
    let parse_presets raw =
        raw |> split "\n"
            |> filter (contains "\"" _)
            |> map (fun line ->
                match split "\"" (trim line) with
                | _ :: name :: _ -> name
                | _ -> "")
            |> filter (_ != "")
    match args with
    | [] when startsWith "-" prefix -> options
    | ["--build"; "--preset"] -> parse_presets $(cmake --list-presets=configure)
    | ["--preset"] | [_; "--preset"] -> parse_presets $(cmake --list-presets=configure)
    | ["-G"] -> generators
    | ["--config"] | [_; "--config"] -> configs
    | _ when startsWith "-" prefix -> options
    | _ -> []

Completion.register "cmake" cmake_complete
