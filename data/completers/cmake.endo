let cmake_options = [
  "--preset"; "--list-presets"; "--build"; "--install";
  "-S"; "-B"; "-G"; "-D"; "--parallel"; "-j";
  "--target"; "-t"; "--config"; "--clean-first";
  "--verbose"; "-v"; "--version"; "--help"
]

let cmake_generators = [
  "Ninja"; "Ninja Multi-Config"; "Unix Makefiles"; "Watcom WMake"
]

let cmake_configs = ["Debug"; "Release"; "RelWithDebInfo"; "MinSizeRel"]

let cmake_presets_from json =
  Json.query ".configurePresets[].name" json
  @ Json.query ".buildPresets[].name" json
  @ Json.query ".testPresets[].name" json

let cmake_complete args prefix =
  match args with
  | [] when startsWith "-" prefix -> cmake_options
  | ["--preset"] | [_; "--preset"] ->
      let json1 = $(cat CMakePresets.json) in
      let json2 = $(cat CMakeUserPresets.json) in
      cmake_presets_from json1 @ cmake_presets_from json2
  | ["-G"] -> cmake_generators
  | ["--config"] | [_; "--config"] -> cmake_configs
  | _ when startsWith "-" prefix -> cmake_options
  | _ -> []

register_completer "cmake" cmake_complete
