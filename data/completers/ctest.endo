let ctest_complete args prefix =
    let options = [
        Completion.described "--preset" "Use a test preset";
        Completion.described "--list-presets" "List available presets";
        Completion.described "--parallel" "Parallel test jobs";
        Completion.described "-j" "Parallel test jobs";
        Completion.described "--build-config" "Build configuration";
        Completion.described "-C" "Build configuration";
        Completion.described "--test-dir" "Test directory";
        Completion.described "--output-on-failure" "Show output on failure";
        Completion.described "--stop-on-failure" "Stop on first failure";
        Completion.described "-R" "Include tests by regex";
        Completion.described "-E" "Exclude tests by regex";
        Completion.described "-L" "Include tests by label";
        Completion.described "--verbose" "Enable verbose output";
        Completion.described "-V" "Enable verbose output";
        Completion.described "--timeout" "Per-test timeout";
        Completion.described "--repeat" "Repeat tests";
        Completion.described "--rerun-failed" "Rerun failed tests"
    ]
    let configs = ["Debug"; "Release"; "RelWithDebInfo"; "MinSizeRel"]
    let parse_presets raw =
        raw |> split "\n"
            |> filter (contains "\"" _)
            |> map (fun line ->
                match split "\"" (trim line) with
                | _ :: name :: _ -> name
                | _ -> "")
            |> filter (_ != "")
    match args with
    | ["--preset"] | [_; "--preset"] -> parse_presets $(cmake --list-presets=configure)
    | ["-C"] | ["--build-config"] | [_; "-C"] | [_; "--build-config"] -> configs
    | _ when startsWith "-" prefix -> options
    | _ -> []

Completion.register "ctest" ctest_complete
