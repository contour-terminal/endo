let is_file_option_last args =
    match last args with
    | Some "-i" -> true
    | Some "-F" -> true
    | Some "-t" -> true
    | _ -> false

let ssh_copy_id_complete args prefix =
    let options = ["-F"; "-f"; "-h"; "-i"; "-n"; "-o"; "-p"; "-s"; "-t"; "-x"]
    match args with
    | _ when is_file_option_last args -> []
    | _ -> options @ (ssh_hosts ())

register_completer "ssh-copy-id" ssh_copy_id_complete
