{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
                "CPM_SOURCE_CACHE": "${sourceDir}/.cache/cpm"
            }
        },
        {
            "name": "unix-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "anyOf",
                "conditions": [
                    { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
                    { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
                ]
            }
        },
        {
            "name": "clang-debug",
            "inherits": "unix-base",
            "displayName": "Clang Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "ENABLE_CLANG_TIDY": "ON",
                "ENABLE_ASAN": "ON",
                "ENABLE_UBSAN": "ON"
            }
        },
        {
            "name": "clang-release",
            "inherits": "unix-base",
            "displayName": "Clang Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "clang-release-native",
            "inherits": "clang-release",
            "displayName": "Clang Release (native arch)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "ENABLE_NATIVE_ARCH": "ON"
            }
        },
        {
            "name": "clang-release-static",
            "inherits": "clang-release",
            "displayName": "Clang Release (static)",
            "cacheVariables": {
                "ENABLE_STATIC_LINKING": "ON"
            }
        },
        {
            "name": "clang-deb",
            "inherits": "clang-release",
            "displayName": "Clang Debian Package (RelWithDebInfo)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_EXE_LINKER_FLAGS": "-Wl,--build-id=sha1"
            }
        },
        {
            "name": "clang-coverage",
            "inherits": "unix-base",
            "displayName": "Clang Coverage",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "ENABLE_COVERAGE": "ON"
            }
        },
        {
            "name": "clang-tsan",
            "inherits": "unix-base",
            "displayName": "Clang ThreadSanitizer",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "ENABLE_TSAN": "ON"
            }
        },
        {
            "name": "gcc-debug",
            "inherits": "unix-base",
            "displayName": "GCC Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "clang-pgo-instrument",
            "inherits": "clang-release-native",
            "displayName": "Clang PGO Instrumentation",
            "cacheVariables": {
                "ENABLE_PGO_INSTRUMENT": "ON"
            }
        },
        {
            "name": "clang-pgo-optimize",
            "inherits": "clang-release-native",
            "displayName": "Clang PGO Optimized",
            "cacheVariables": {
                "ENABLE_PGO_OPTIMIZE": "ON"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "cl-debug",
            "inherits": "windows-base",
            "displayName": "MSVC Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "cl-release",
            "inherits": "windows-base",
            "displayName": "MSVC Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl"
            }
        },
        {
            "name": "clangcl-debug",
            "inherits": "windows-base",
            "displayName": "Clang-CL Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        },
        {
            "name": "clangcl-release",
            "inherits": "windows-base",
            "displayName": "Clang-CL Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang-cl",
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        },
        {
            "name": "emscripten-release",
            "inherits": "base",
            "displayName": "Emscripten Release (WASM)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "ENABLE_ASAN": "OFF",
                "ENABLE_UBSAN": "OFF",
                "ENABLE_TSAN": "OFF",
                "ENABLE_COVERAGE": "OFF",
                "ENABLE_NATIVE_ARCH": "OFF",
                "ENABLE_STATIC_LINKING": "OFF",
                "ENABLE_PGO_INSTRUMENT": "OFF",
                "ENABLE_PGO_OPTIMIZE": "OFF",
                "ENABLE_CLANG_TIDY": "OFF",
                "ENDO_TRACE_VM": "OFF",
                "ENDO_TRACE_PARSER": "OFF",
                "ENDO_TRACE_LEXER": "OFF",
                "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug"
        },
        {
            "name": "clang-release",
            "configurePreset": "clang-release"
        },
        {
            "name": "clang-release-native",
            "configurePreset": "clang-release-native"
        },
        {
            "name": "clang-release-static",
            "configurePreset": "clang-release-static"
        },
        {
            "name": "clang-deb",
            "configurePreset": "clang-deb"
        },
        {
            "name": "clang-coverage",
            "configurePreset": "clang-coverage"
        },
        {
            "name": "clang-tsan",
            "configurePreset": "clang-tsan"
        },
        {
            "name": "gcc-debug",
            "configurePreset": "gcc-debug"
        },
        {
            "name": "clang-pgo-instrument",
            "configurePreset": "clang-pgo-instrument"
        },
        {
            "name": "clang-pgo-optimize",
            "configurePreset": "clang-pgo-optimize"
        },
        {
            "name": "cl-debug",
            "configurePreset": "cl-debug"
        },
        {
            "name": "cl-release",
            "configurePreset": "cl-release"
        },
        {
            "name": "clangcl-debug",
            "configurePreset": "clangcl-debug"
        },
        {
            "name": "clangcl-release",
            "configurePreset": "clangcl-release"
        },
        {
            "name": "emscripten-release",
            "configurePreset": "emscripten-release"
        }
    ],
    "testPresets": [
        {
            "name": "clang-debug",
            "configurePreset": "clang-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 4
