# description: Inlined untyped function with match creates blocks during record update value codegen.
# expect: { x = 6; y = 4 }

type Point = { x: int; y: int }

let double n =
    match n with
    | 0 -> 0
    | n -> n * 2

let p1 = { x = 3; y = 4 }

let p2 = { p1 with x = double (p1.x) }

print p2
