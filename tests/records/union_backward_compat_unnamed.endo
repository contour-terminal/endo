# description: Unnamed fields still work exactly as before (no regression)
# expect: 30

type Shape =
    | Circle of int
    | Rectangle of int * int
    | Point
let s = Rectangle (5, 6)
let r = match s with
    | Circle r -> r * r
    | Rectangle (w, h) -> w * h
    | Point -> 0
print r
