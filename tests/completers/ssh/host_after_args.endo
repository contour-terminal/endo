# description: SSH completer: host completion after prior args
# session-separator: ---
# source-file: data/completers/ssh.endo
# expect: server1
# expect: server2
# expect: gateway
# expect:

let ssh_hosts _ = ["server1"; "server2"; "gateway"]

# ---
let _ = ssh_complete ["host"] "" |> each println
