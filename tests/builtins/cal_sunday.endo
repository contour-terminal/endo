# description: cal -s (Sunday-start) produces output
# mode: shell
# expect-expr: _ |> contains "April 2026"
# expect-expr: _ |> contains "Su Mo Tu We Th Fr Sa"
# expect-expr: _ |> contains "5  6  7  8  9 10 11"
# expect-expr: _ |> contains "26 27 28 29 30"

cal --no-color -s 4 2026
