#
# description: File.size dispatches correctly
# mode: ir-only

let path = $"{Path.temporary_directory}/endo_test_file_size.txt"

let _ = File.writeAll path "hello"

match File.size path with
| Ok n -> println n
| Error e -> println e

let _ = File.delete path
