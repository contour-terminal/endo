#
# description: File.writeAll and File.readAll compile and dispatch correctly
# mode: ir-only

let path = $"{Path.temporary_directory}/endo_test_file_write_read.txt"

ignore (File.writeAll path "Hello, World!")

match File.readAll path with
| Ok content -> println content
| Error e -> println e

ignore (File.delete path)
