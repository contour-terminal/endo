{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Endo",
  "scopeName": "source.endo",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#function-definition" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.hash.endo",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.endo",
          "match": "//.*$"
        },
        {
          "name": "comment.block.endo",
          "begin": "\\(\\*",
          "end": "\\*\\)",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        { "include": "#fstring" },
        { "include": "#dstring" },
        { "include": "#sstring" }
      ]
    },
    "fstring": {
      "name": "string.interpolated.fsharp.endo",
      "begin": "\\$\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.endo",
          "match": "\\\\[nrt\\\\\"0]"
        },
        {
          "name": "constant.character.escape.brace.endo",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "name": "meta.interpolation.endo",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.endo" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.endo" }
          },
          "patterns": [
            { "include": "source.endo" }
          ]
        }
      ]
    },
    "dstring": {
      "name": "string.quoted.double.endo",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.endo",
          "match": "\\\\[nrt\\\\$\"0]"
        },
        {
          "name": "variable.other.interpolation.endo",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "meta.interpolation.shell.endo",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.endo" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.endo" }
          },
          "patterns": [
            { "include": "source.endo" }
          ]
        },
        {
          "name": "meta.interpolation.command.endo",
          "begin": "\\$\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.endo" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.endo" }
          },
          "patterns": [
            { "include": "source.endo" }
          ]
        },
        {
          "name": "meta.interpolation.arithmetic.endo",
          "begin": "\\$\\(\\(",
          "end": "\\)\\)",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.endo" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.endo" }
          },
          "patterns": [
            { "include": "source.endo" }
          ]
        }
      ]
    },
    "sstring": {
      "name": "string.quoted.single.endo",
      "begin": "'",
      "end": "'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.size.endo",
          "match": "\\b[0-9]+(\\.[0-9]+)?(TB|GB|MB|KB|B)\\b"
        },
        {
          "name": "constant.numeric.timespan.endo",
          "match": "\\b[0-9]+(\\.[0-9]+)?(ms|min|h|s)\\b"
        },
        {
          "name": "constant.numeric.hex.endo",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.octal.endo",
          "match": "\\b0o[0-7]+\\b"
        },
        {
          "name": "constant.numeric.binary.endo",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.endo",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.scientific.endo",
          "match": "\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.endo",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.endo",
          "match": "\\b(if|then|else|elif|end|for|in|do|while|match|with|when|try|finally|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.endo",
          "match": "\\b(let|mut|fun|type|rec|and|of|as|export|global|lazy|use)\\b"
        },
        {
          "name": "keyword.other.endo",
          "match": "\\b(seq|yield)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.endo",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.option.endo",
          "match": "\\b(Some|None)\\b"
        },
        {
          "name": "constant.language.result.endo",
          "match": "\\b(Ok|Error)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.endo",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(let)\\s+(rec\\s+)?([a-z_][a-zA-Z0-9_]*[!?]?)\\s+",
          "captures": {
            "1": { "name": "keyword.declaration.endo" },
            "2": { "name": "keyword.declaration.endo" },
            "3": { "name": "entity.name.function.endo" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.endo",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.arrow.endo",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.assignment.endo",
          "match": "<-"
        },
        {
          "name": "keyword.operator.cons.endo",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.endo",
          "match": "\\.\\.(=)?"
        },
        {
          "name": "keyword.operator.comparison.endo",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.endo",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.endo",
          "match": "\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.misc.endo",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.endo",
          "match": "[;,]"
        },
        {
          "name": "punctuation.bracket.round.endo",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.square.endo",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.curly.endo",
          "match": "[{}]"
        }
      ]
    }
  }
}
